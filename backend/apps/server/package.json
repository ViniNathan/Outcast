{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@backend/api": "workspace:*",
    "@backend/db": "workspace:*",
    "@backend/env": "workspace:*",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/trpc": "^1.1.0",
    "@hono/trpc-server": "^0.4.0",
    "@langchain/classic": "^1.0.9",
    "@langchain/core": "^1.1.15",
    "@langchain/google-genai": "^2.1.10",
    "@langchain/openai": "^1.2.2",
    "@trpc/server": "catalog:",
    "dotenv": "catalog:",
    "elysia": "catalog:",
    "langchain": "^1.2.10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@backend/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "catalog:"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
