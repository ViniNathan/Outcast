generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "postgresql"
}

enum MissionCategory {
  DAILY
  WEEKLY
  MONTHLY
}

enum MissionStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum MissionDifficulty {
  E
  D
  C
  B
  A
  S
}

enum MissionSource {
  AUTOMATIC
  USER_REQUEST
}

enum LogType {
  INFO
  WARNING
  SUCCESS
  FAILURE
}

model User {
  id         String   @id @default(cuid())
  authUserId String   @unique
  name       String
  age        Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  player Player?

  @@index([authUserId])
}

model Player {
  id           String   @id @default(cuid())
  userId       String   @unique
  xp           Int      @default(0)
  level        Int      @default(1)
  class        String   @default("OUTCAST")
  rank         Int      @default(0)
  attributes   Json?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectives Objective[]
  missions   Mission[]
  logs       SystemLog[]
  rankings   Ranking[]
  settings   PlayerSettings?

  @@index([level, xp, createdAt])
}

model Objective {
  id          String   @id @default(cuid())
  playerId    String
  description String
  createdAt   DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

model Mission {
  id                 String            @id @default(cuid())
  playerId           String
  category           MissionCategory
  title              String
  description        String
  difficulty         MissionDifficulty
  status             MissionStatus     @default(PENDING)
  xpReward           Int
  xpPenalty          Int
  attributesRewarded Json?
  progressCurrent    Int               @default(0)
  progressTarget     Int
  progressUnit       String
  expiresAt          DateTime
  completedAt        DateTime?
  source             MissionSource
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, status, expiresAt])
}

model PlayerSettings {
  id                    String   @id @default(cuid())
  playerId              String   @unique
  autoMissionGeneration Boolean  @default(true)
  isPremium             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, autoMissionGeneration])
}

model SystemLog {
  id        String   @id @default(cuid())
  playerId  String
  message   String
  type      LogType
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

model Ranking {
  id           String   @id @default(cuid())
  playerId     String
  position     Int
  snapshotDate DateTime
  createdAt    DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([snapshotDate])
  @@index([playerId, snapshotDate])
}
